# Frontend (Vercel ou frontend/.env.local)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_DEFAULT_EDITION=normal
# Lista pública opcional de trackers WebSocket confiáveis, separados por vírgula:
# VITE_WEBTORRENT_TRACKERS=wss://tracker.example

# API (Render ou backend/.env)
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
TMDB_API_READ_TOKEN=
ADDON_ALLOW_HTTP=false
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
WETRAKR_CLIENT_ID=
DATABASE_URL=
SYNC_JWT_SECRET=

# API-only secret; never put this in VITE_ variables.
ADMIN_API_KEY=

# Server-side direct-file decoder fallback (requires FFmpeg in the API container)
FFMPEG_PATH=ffmpeg
MEDIA_TRANSCODE_ENABLED=false
MEDIA_MAX_CONCURRENT=1
MEDIA_SESSION_TTL_SECONDS=7200
MEDIA_MAX_INPUT_GB=12
MEDIA_MAX_DURATION_SECONDS=7200
MEDIA_MAX_HEIGHT=720
PUBLIC_API_BASE_URL=
