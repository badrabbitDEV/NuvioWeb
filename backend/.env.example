PORT=4000
NODE_ENV=development
# Comma-separated exact origins. Include the Vercel production and preview origins you use.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# TMDB Read Access Token (Bearer). Keep this only on Render; never use a VITE_ prefix.
TMDB_API_READ_TOKEN=
# Set true only for local development/testing of non-HTTPS addon manifests.
ADDON_ALLOW_HTTP=false

# Provider OAuth credentials (create your own developer applications)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=

# WeTrakr app client ID (register your own application with WeTrakr)
WETRAKR_CLIENT_ID=

# Required for the protected admin dashboard. Generate at least 32 random characters.
ADMIN_API_KEY=

# Optional FFmpeg direct-file fallback. Production Dockerfile installs FFmpeg.
FFMPEG_PATH=ffmpeg
MEDIA_TRANSCODE_ENABLED=false
MEDIA_MAX_CONCURRENT=1
MEDIA_SESSION_TTL_SECONDS=7200
MEDIA_MAX_INPUT_GB=12
MEDIA_MAX_DURATION_SECONDS=7200
MEDIA_MAX_HEIGHT=720
PUBLIC_API_BASE_URL=
