import { useCallback, useEffect, useState, type Dispatch, type SetStateAction } from 'react';

export function readStored<T>(key: string, fallback: T): T {
  try {
    const raw = localStorage.getItem(key);
    return raw ? (JSON.parse(raw) as T) : fallback;
  } catch {
    return fallback;
  }
}

export function useStoredState<T>(key: string, fallback: T): [T, Dispatch<SetStateAction<T>>] {
  const [stored, setStored] = useState<{ key: string; value: T }>(() => ({ key, value: readStored(key, fallback) }));
  useEffect(() => {
    setStored({ key, value: readStored(key, fallback) });
  }, [key]);
  const value = stored.key === key ? stored.value : readStored(key, fallback);
  const setValue = useCallback<Dispatch<SetStateAction<T>>>((next) => {
    setStored((current) => {
      const base = current.key === key ? current.value : readStored(key, fallback);
      const value = typeof next === 'function' ? (next as (previous: T) => T)(base) : next;
      return { key, value };
    });
  }, [key, fallback]);
  useEffect(() => {
    if (stored.key !== key) return;
    try { localStorage.setItem(key, JSON.stringify(stored.value)); }
    catch { /* Storage may be disabled or full. */ }
  }, [key, stored]);
  return [value, setValue];
}

const DB_NAME = 'nuvio-web-port';
const DB_VERSION = 1;
let dbPromise: Promise<IDBDatabase> | null = null;

function openDatabase(): Promise<IDBDatabase> {
  if (typeof indexedDB === 'undefined') return Promise.reject(new Error('IndexedDB indisponível neste navegador.'));
  if (dbPromise) return dbPromise;
  dbPromise = new Promise((resolve, reject) => {
    const request = indexedDB.open(DB_NAME, DB_VERSION);
    request.onupgradeneeded = () => {
      const db = request.result;
      if (!db.objectStoreNames.contains('downloads')) db.createObjectStore('downloads', { keyPath: 'id' });
      if (!db.objectStoreNames.contains('metadata')) db.createObjectStore('metadata', { keyPath: 'key' });
      if (!db.objectStoreNames.contains('watch-progress')) db.createObjectStore('watch-progress', { keyPath: 'mediaKey' });
    };
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error ?? new Error('Falha ao abrir IndexedDB.'));
    request.onblocked = () => reject(new Error('O banco local está bloqueado por outra aba.'));
  });
  return dbPromise;
}

export async function idbPut<T>(store: 'downloads' | 'metadata' | 'watch-progress', value: T): Promise<void> {
  const db = await openDatabase();
  await new Promise<void>((resolve, reject) => {
    const request = db.transaction(store, 'readwrite').objectStore(store).put(value);
    request.onsuccess = () => resolve();
    request.onerror = () => reject(request.error ?? new Error('Falha ao salvar dados locais.'));
  });
}
export async function idbGetAll<T>(store: 'downloads' | 'metadata' | 'watch-progress'): Promise<T[]> {
  const db = await openDatabase();
  return new Promise((resolve, reject) => {
    const request = db.transaction(store, 'readonly').objectStore(store).getAll();
    request.onsuccess = () => resolve((request.result ?? []) as T[]);
    request.onerror = () => reject(request.error ?? new Error('Falha ao ler dados locais.'));
  });
}
